[req]
prompt             = no
default_md         = sha256
distinguished_name = dn
x509_extensions    = ext

[dn]
CN = app.teamepicrouter.test
O  = teamepicrouter CN Project

[ext]
subjectAltName   = DNS:app.teamepicrouter.test, DNS:api.teamepicrouter.test
basicConstraints = critical, CA:FALSE
keyUsage         = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
