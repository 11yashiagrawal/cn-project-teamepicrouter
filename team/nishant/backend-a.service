# /etc/systemd/system/backend-a.service – installed by `make converge`
[Unit]
Description=CN project Backend A (REST API on port 3001)
After=network-online.target
Wants=network-online.target

[Service]
Environment=BACKEND_ID=A PORT=3001 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/cn/backend.py
# Restart only after a crash – `systemctl stop` keeps it stopped for failure demos
Restart=on-failure
RestartSec=2
DynamicUser=yes

[Install]
WantedBy=multi-user.target
